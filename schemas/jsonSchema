const schema = {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Real Estate Property",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "type",
      "price",
      "currency",
      "location",
      "status"
    ],
    "properties": {
      "id": {
        "type": "integer"
      },

      "title": {
        "type": "string",
        "minLength": 5
      },

      "type": {
        "type": "string",
        "enum": [
          "Apartment",
          "House",
          "Penthouse",
          "Studio",
          "Villa",
          "Farmhouse",
          "Townhouse"
        ]
      },

      "price": {
        "type": "number",
        "minimum": 0
      },

      "price_per_m2": {
        "type": "number",
        "minimum": 0
      },

      "currency": {
        "type": "string",
        "enum": ["EUR", "USD", "GBP", "JPY", "CNY"]
      },

      "property": {
        "type": "object",
        "required": [
          "bedrooms",
          "bathrooms",
          "surface_m2"
        ],
        "properties": {
          "bedrooms": {
            "type": "integer",
            "minimum": 0
          },

          "bathrooms": {
            "type": "integer",
            "minimum": 0
          },

          "surface_m2": {
            "type": "number",
            "minimum": 0
          },

          "terrace": {
            "type": "boolean"
          },

          "elevator": {
            "type": "boolean"
          },

          "garage": {
            "type": "boolean"
          },

          "storage_room": {
            "type": "boolean"
          },

          "floor": {
            "type": "integer"
          },

          "orientation": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["north", "south", "east", "west"]
            }
          }
        },
        "additionalProperties": false
      },

      "building": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer"
          },

          "neighbors": {
            "type": "integer"
          },

          "floors": {
            "type": "integer"
          },

          "extras": {
            "type": "object",
            "properties": {
              "pool": {
                "type": "string",
                "enum": ["private", "shared", "none"]
              },

              "gym": {
                "type": "boolean"
              },

              "jacuzzi": {
                "type": "boolean"
              },

              "sports_courts": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },

      "location": {
        "type": "object",
        "required": [
          "city",
          "country"
        ],
        "properties": {
          "street": {
            "type": "string"
          },

          "city": {
            "type": "string"
          },

          "postal_code": {
            "type": "string"
          },

          "province": {
            "type": "string"
          },

          "country": {
            "type": "string",
            "enum": ["ES", "FR", "PT"]
          },

          "visibility": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },

      "status": {
        "type": "string",
        "enum": [
          "Available",
          "Reserved",
          "Sold"
        ]
      },

      "legalStatus": {
        "type": "string",
        "enum": [
          "free",
          "occupied",
          "under_litigation"
        ]
      }
    },

    "additionalProperties": false
  }
};